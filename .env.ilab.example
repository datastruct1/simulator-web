# Copy to .env.ilab.local (ignored by Git). Never use VITE_* for secrets.
# Default test mode uses the public credentials from the official technical guide.
ILAB_MODE=test
ILAB_APPID=10000
ILAB_SECRET=DDO7jw9TAZlLwRLRKSpBWXIlYZe9PKaD5Wc1S5ZQ0U8=

# REQUIRED: fill in the actual declared project title, 1-100 characters.
# Empty means the integration stays disabled and sends no upstream requests.
ILAB_PROJECT_TITLE=
ILAB_REQUIRES_AI_DATA=true
ILAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ILAB_HOST=127.0.0.1
ILAB_PORT=8787
ILAB_COOKIE_SECURE=false
ILAB_DATA_DIR=.ilab-data

# Production: change MODE to production, APPID to 110602, and SECRET to your private project key.
# Also set the actual HTTPS site origin in ALLOWED_ORIGINS; Secure cookies are forced in production.
# Do not put private production credentials into test mode or commit this local file.
